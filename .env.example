# این فایل را کپی کرده و به نام .env ذخیره کنید (فقط برای تست لوکال؛
# در گیت‌هاب اکشن این مقادیر از بخش Secrets/Variables خوانده می‌شوند)

EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=youraddress@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_TO=you@example.com,other@example.com

MAX_CRYPTO_SYMBOLS=40
MIN_QUOTE_VOLUME_USDT=5000000
CRYPTO_TIMEFRAME=1h
CRYPTO_CANDLE_LIMIT=300
TOP_SIGNALS_COUNT=15

GOLD_TICKERS=GC=F
GOLD_INTERVAL=1h
GOLD_PERIOD=60d

TIMEZONE=Asia/Tehran
SIGNAL_HISTORY_FILE=signal_history.csv
